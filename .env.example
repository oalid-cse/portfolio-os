# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap, robots and OG tags.
# Set to the final domain in Vercel (the CONTENT-NEEDED demo value is https://abubinoalid.dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend API key for the contact form. Leave empty to disable the form. Must be set at BUILD time.
RESEND_API_KEY=
# Inbox that receives contact messages. Leave empty to disable the form. Must be set at BUILD time.
CONTACT_TO_EMAIL=
